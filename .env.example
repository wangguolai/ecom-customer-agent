# 复制为 .env 并填入真实值（.env 已在 .gitignore 排除，勿提交真实密钥）

# ── DeepSeek LLM ──
DEEPSEEK_API_KEY=your_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # 可选，默认官方地址
DEEPSEEK_MODEL=deepseek-chat
# LLM_TIMEOUT=60

# ── MySQL ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=ecommerce

# ── Redis ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── 鉴权（生产必须改成强密钥）──
AUTH_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ── agent 工具连后端的地址 ──
BACKEND_URL=http://localhost:8000

# ── 转人工在线状态（demo mock，true/false）──
CS_ONLINE=true

# ── 故障注入调试端点（默认关闭，勿在生产开启）──
ENABLE_DEBUG_FAULT=0
